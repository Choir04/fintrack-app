# Database URL untuk PostgreSQL (Bisa menggunakan Neon.tech, Supabase, atau Vercel Postgres)
# Contoh dari Neon: postgresql://username:password@ep-xyz-123.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fintrack_db?schema=public"

